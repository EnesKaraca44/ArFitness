<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_host"
    app:startDestination="@id/entryFragment">

    <fragment
        android:id="@+id/anasayfaFragment"
        android:name="com.example.arfitness.fragment.AnasayfaFragment"
        android:label="fragment_anasayfa"
        tools:layout="@layout/fragment_anasayfa" >
        <action
            android:id="@+id/anadanhistorıye"
            app:destination="@id/historyFragment" />
        <action
            android:id="@+id/anadanexercise"
            app:destination="@id/exerciseFragment" />
        <action
            android:id="@+id/anadandetaya"
            app:destination="@id/exerciseDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/exerciseFragment"
        android:name="com.example.arfitness.fragment.ExerciseFragment"
        android:label="fragment_exercise"
        tools:layout="@layout/fragment_exercise" >
        <argument
            android:name="exerciseName"
            app:argType="string" />
        <action
            android:id="@+id/exercisidenresulta"
            app:destination="@id/resultFragment" />
    </fragment>
    <fragment
        android:id="@+id/historyFragment"
        android:name="com.example.arfitness.fragment.HistoryFragment"
        android:label="fragment_history"
        tools:layout="@layout/fragment_history" />
    <fragment
        android:id="@+id/resultFragment"
        android:name="com.example.arfitness.fragment.ResultFragment"
        android:label="fragment_result"
        tools:layout="@layout/fragment_result" >
        <action
            android:id="@+id/resulttananaya"
            app:destination="@id/anasayfaFragment" />
        <argument
            android:name="workoutResult"
            app:argType="com.example.arfitness.entitiy.WorkoutResult" />
    </fragment>
    <fragment
        android:id="@+id/exerciseDetailFragment"
        android:name="com.example.arfitness.fragment.ExerciseDetailFragment"
        android:label="fragment_exercise_detail"
        tools:layout="@layout/fragment_exercise_detail" >
        <action
            android:id="@+id/exercisdendetaya"
            app:destination="@id/exerciseFragment" />
        <argument
            android:name="egzersizDetay"
            app:argType="com.example.arfitness.entitiy.EgzersizDetay" />
    </fragment>
    <fragment
        android:id="@+id/userFragment"
        android:name="com.example.arfitness.fragment.UserFragment"
        android:label="fragment_user"
        tools:layout="@layout/fragment_user" >
        <action
            android:id="@+id/action_userFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
        <action
            android:id="@+id/action_userFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
    </fragment>
    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.example.arfitness.fragment.EditProfileFragment"
        android:label="EditProfileFragment" />
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.arfitness.fragment.SettingsFragment"
        android:label="@string/settings"
        tools:layout="@layout/fragment_settings" />
    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.example.arfitness.fragment.OnboardingFragment"
        android:label="fragment_onboarding"
        tools:layout="@layout/fragment_onboarding" >
        <action
            android:id="@+id/action_onboardingFragment_to_anasayfaFragment"
            app:destination="@id/anasayfaFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/entryFragment"
        android:name="com.example.arfitness.fragment.EntryFragment"
        android:label="EntryFragment" >
        <action
            android:id="@+id/action_entryFragment_to_anasayfaFragment"
            app:destination="@id/anasayfaFragment"
            app:popUpTo="@id/entryFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_entryFragment_to_onboardingFragment"
            app:destination="@id/onboardingFragment"
            app:popUpTo="@id/entryFragment"
            app:popUpToInclusive="true" />
    </fragment>
</navigation>
